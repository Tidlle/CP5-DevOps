      "response (200)": { "id": 1, "tipo": "DEPOSITO", "valor": 300.00, "descricao": "Salario corrigido", "dataHora": "2026-10-05T10:30:00", "contaId": 1 }
    },
    "DELETE /api/transacoes/1": {
      "observacao": "Estorna o valor no saldo da conta.",
