      "request": { "contaId": 1, "tipo": "DEPOSITO", "valor": 250.50, "descricao": "Salario" },
      "response (201)": { "id": 1, "tipo": "DEPOSITO", "valor": 250.50, "descricao": "Salario", "dataHora": "2026-10-05T10:30:00", "contaId": 1 }
