      ]
    },
    "GET /api/transacoes/1": {
      "response (200)": { "id": 1, "tipo": "DEPOSITO", "valor": 250.50, "descricao": "Salario", "dataHora": "2026-10-05T10:30:00", "contaId": 1 }
    },
    "PUT /api/transacoes/1": {
      "observacao": "Estorna o efeito antigo no saldo e aplica o novo.",
