    },
    "PUT /api/contas/1": {
      "observacao": "O saldo informado e ignorado: so muda por transacoes.",
      "request": { "numero": "12345-6", "agencia": "0002", "titular": "Joao da Silva", "saldo": 0 },
      "response (200)": { "id": 1, "numero": "12345-6", "agencia": "0002", "titular": "Joao da Silva", "saldo": 1000.00 }
    },
    "DELETE /api/contas/1": {
      "observacao": "Remove a conta e, em cascata, suas transacoes.",
      "response": "204 No Content"
    }
  },
  "transacoes": {
