  "baseUrl": "https://dimdim-SUFIXO.azurewebsites.net",
  "contas": {
    "POST /api/contas": {
      "request": { "numero": "12345-6", "agencia": "0001", "titular": "Joao Silva", "saldo": 1000.00 },
      "response (201)": { "id": 1, "numero": "12345-6", "agencia": "0001", "titular": "Joao Silva", "saldo": 1000.00 }
    },
    "GET /api/contas": {
      "response (200)": [
